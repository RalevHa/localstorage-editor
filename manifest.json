{
  "manifest_version": 3,
  "name": "localStorage Editor",
  "version": "1.0.0",
  "description": "Edit a page's localStorage as a searchable form, with bulk set and save-proof reload.",
  "homepage_url": "https://github.com/RalevHa/localstorage-editor",
  "permissions": ["activeTab", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "localStorage Editor",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
